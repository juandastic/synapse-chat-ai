{
  "name": "@synapse/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npx expo start",
    "ios": "npx expo run:ios",
    "android": "npx expo run:android",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:simulator": "eas build --profile development-simulator --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update": "eas update --branch production",
    "build": "npx expo export",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clerk/expo": "^3.1.6",
    "@convex-dev/r2": "^0.9.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-navigation/drawer": "^7.9.8",
    "@synapse/backend": "*",
    "convex": "^1.32.0",
    "expo": "~55.0.11",
    "expo-asset": "~55.0.12",
    "expo-auth-session": "^55.0.12",
    "expo-clipboard": "^55.0.11",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.10",
    "expo-dev-client": "~55.0.22",
    "expo-font": "~55.0.6",
    "expo-haptics": "^55.0.11",
    "expo-image-picker": "^55.0.16",
    "expo-linking": "~55.0.11",
    "expo-localization": "^55.0.11",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.11",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.18",
    "expo-web-browser": "^55.0.12",
    "lucide-react-native": "^1.7.0",
    "posthog-react-native": "^4.39.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.0"
  }
}

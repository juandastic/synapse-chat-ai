{
  "name": "@synapse/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./dataModel": "./convex/_generated/dataModel.d.ts",
    "./chatModels": "./convex/chatModels.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project backend",
    "dev": "npx convex dev --env-file ../../.env.local",
    "deploy": "npx convex deploy",
    "test:watch": "vitest --root ../.. --project backend",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@convex-dev/r2": "^0.9.1",
    "convex": "^1.32.0",
    "posthog-node": "^5.28.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}

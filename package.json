{
  "name": "synapse-ai-chat",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev --filter=@synapse/web --filter=@synapse/backend",
    "dev:web": "turbo dev --filter=@synapse/web",
    "dev:mobile": "turbo dev --filter=@synapse/mobile --filter=@synapse/backend",
    "dev:expo": "npm run dev --workspace=@synapse/mobile",
    "dev:expo:ios": "npm run ios --workspace=@synapse/mobile",
    "dev:expo:android": "npm run android --workspace=@synapse/mobile",
    "dev:convex": "npm run dev --workspace=@synapse/backend",
    "dev:ios": "npm run dev --workspace=@synapse/backend & npm run ios --workspace=@synapse/mobile",
    "dev:android": "npm run dev --workspace=@synapse/backend & npm run android --workspace=@synapse/mobile",
    "build": "turbo build",
    "build:deploy": "npm run deploy --workspace=@synapse/backend -- --cmd 'npm run build --workspace=@synapse/web'",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  }
}

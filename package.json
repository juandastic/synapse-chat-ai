{
  "name": "synapse-ai-chat",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@synapse/web --filter=@synapse/backend",
    "dev:web": "turbo dev --filter=@synapse/web",
    "dev:mobile": "turbo dev --filter=@synapse/mobile --filter=@synapse/backend",
    "dev:expo": "npm run dev --workspace=@synapse/mobile",
    "dev:expo:ios": "npm run ios --workspace=@synapse/mobile",
    "dev:expo:android": "npm run android --workspace=@synapse/mobile",
    "dev:convex": "npm run dev --workspace=@synapse/backend",
    "dev:ios": "npm run dev --workspace=@synapse/backend & npm run ios --workspace=@synapse/mobile",
    "dev:android": "npm run dev --workspace=@synapse/backend & npm run android --workspace=@synapse/mobile",
    "build": "turbo build",
    "build:deploy": "npm run deploy --workspace=@synapse/backend -- --cmd 'npm run build --workspace=@synapse/web'",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:mobile",
    "test:unit": "vitest run",
    "test:web": "vitest run --project web",
    "test:backend": "vitest run --project backend",
    "test:mobile": "npm run test --workspace=@synapse/mobile",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:coverage --workspace=@synapse/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,mts,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,mts,json,css}\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify:build": "npm run verify && npm run build --workspace=@synapse/web"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
